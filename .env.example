# ============================================================
# .env.example - Backend Node.js
# Copiar como .env y completar con valores reales
# NUNCA subir el archivo .env al repositorio
# ============================================================

# Puerto del servidor Express
PORT=3000

# Entorno de ejecución
NODE_ENV=production

# Configuración de base de datos MySQL
DB_HOST=mysql          # Nombre del servicio en docker-compose
DB_PORT=3306
DB_NAME=proyecto_db
DB_USER=app_user
DB_PASSWORD=cambiar_password_seguro

# Contraseña root de MySQL (solo para docker-compose)
MYSQL_ROOT_PASSWORD=cambiar_root_password_seguro
